# Postgres connection. The tables live in the `aces` schema, so this can be the
# same Neon database posession and emptynet use - nothing collides.
#   postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Where raw API responses are kept so a re-run costs nothing.
# Defaults to ./cache next to this file.
ACES_CACHE=
